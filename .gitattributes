# Enforce LF for code files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary — don't diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.afdesign binary
*.docx binary
